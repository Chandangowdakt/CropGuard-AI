# CropGuard AI — environment variables
# Copy this file to .env and fill in your values:
#   copy .env.example .env

# JWT secret (change in production)
JWT_SECRET=cropguard-dev-jwt-secret-change-in-production

# AI model path (optional — uses default chrysanthemum path if unset)
# CROPGUARD_MODEL_PATH=C:\path\to\chrysanthemum_model.pth

# ── Twilio WhatsApp alerts (optional) ─────────────────────────────────────
# Sign up: https://www.twilio.com/try-twilio
# Join sandbox: send "join [word]" to +1 415 523 8886 on WhatsApp
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
ALERT_PHONE=whatsapp:+91XXXXXXXXXX

# ── Email alerts (optional) ─────────────────────────────────────────────
# Gmail: use an App Password — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Admin dashboard link included in scan report emails
FRONTEND_URL=http://localhost:5500
